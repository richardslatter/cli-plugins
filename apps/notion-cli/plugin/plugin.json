{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notion-cli",
  "version": "0.2.1",
  "description": "Search and read pages and data sources with the official Notion CLI.",
  "author": {
    "name": "Richard Slatter"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Notion CLI",
        "shortDescription": "Read Notion workspace",
        "longDescription": "Search and read pages and data sources with the official Notion CLI. Read-only tools use the account selected for each connection.",
        "developerName": "Richard Slatter",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read"
        ],
        "defaultPrompt": [
          "Show my connected account.",
          "Find recent pages in my Notion workspace."
        ],
        "logo": "./assets/notion-cli.svg",
        "composerIcon": "./assets/notion-cli.svg",
        "websiteURL": "https://cli-plugins.onrender.com/apps/notion-cli"
      }
    }
  },
  "homepage": "https://cli-plugins.onrender.com/apps/notion-cli",
  "repository": "https://github.com/richardslatter/cli-plugins"
}
