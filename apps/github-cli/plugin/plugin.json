{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "github-cli",
  "version": "0.2.1",
  "description": "Read repositories, code, issues and pull requests with the official GitHub CLI.",
  "author": {
    "name": "Richard Slatter"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "GitHub CLI",
        "shortDescription": "Read GitHub repositories",
        "longDescription": "Read repositories, code, issues and pull requests with the official GitHub CLI. Read-only tools use the account selected for each connection.",
        "developerName": "Richard Slatter",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read"
        ],
        "defaultPrompt": [
          "Show my connected account.",
          "List my GitHub repositories."
        ],
        "logo": "./assets/github-cli.svg",
        "composerIcon": "./assets/github-cli.svg",
        "websiteURL": "https://cli-plugins.onrender.com/apps/github-cli"
      }
    }
  },
  "homepage": "https://cli-plugins.onrender.com/apps/github-cli",
  "repository": "https://github.com/richardslatter/cli-plugins"
}
